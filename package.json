{
  "name": "heatmap-tracker",
  "version": "2.16.0",
  "description": "A heatmap tracker plugin for Obsidian",
  "homepage": "https://mokkiebear.github.io/heatmap-tracker/",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:debug": "node esbuild.config.mjs --debug",
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -noEmit -skipLibCheck && node esbuild.config.mjs --production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest",
    "test:usa": "TZ=America/New_York jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:obsidian": "eslint --no-config-lookup -c eslint.obsidian.config.mjs \"src/**/*.ts\" \"src/**/*.tsx\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "jest --coverage",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm test",
    "verify:tz": "npm run test:usa",
    "harness": "node harness/esbuild.harness.mjs --serve",
    "harness:build": "node harness/esbuild.harness.mjs",
    "harness:shots": "node harness/screenshot.mjs"
  },
  "keywords": [
    "obsidian"
  ],
  "author": "Maksim Rubanau (mokkiebear)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "obsidian": "latest",
    "obsidian-daily-notes-interface": "^0.9.4",
    "obsidian-dataview": "^0.5.68",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "overrides": {
    "svelte": "3.59.2",
    "@codemirror/language": "^6.12.3"
  }
}
